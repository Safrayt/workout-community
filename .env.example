# Скопируйте этот файл в .env (в корне проекта, рядом с
# docker-compose.yml) и заполните реальными значениями.
# Сам .env в git попадать не должен (добавьте в .gitignore, если
# ещё не добавлен) — в нём секретный ключ.

# Секретный ключ для подписи JWT-токенов входа. Обязателен.
# Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Ваш домен, когда он появится (например streetworkout.lol).
# Пока домена нет — просто не задавайте эту переменную вообще
# (или оставьте пустой) — тогда Caddy будет работать на localhost,
# без HTTPS, что удобно для локальной проверки.
DOMAIN=

# Обычно совпадает с DOMAIN (с https:// и без слэша на конце).
# Можно указать несколько через запятую, если сайт доступен
# по нескольким адресам (с www и без, например).
CORS_ORIGINS=

# Домен(ы), на которые бэкенд согласится отвечать (тоже через
# запятую, без https:// и без слэша).
ALLOWED_HOSTS=

# Пароль для базы данных PostgreSQL. Обязателен.
# Сгенерировать: openssl rand -hex 24
# (Логин и имя базы можно не задавать — по умолчанию используется
# "workout" и для того, и для другого; при желании переопределите
# через POSTGRES_USER и POSTGRES_DB.)
POSTGRES_PASSWORD=
