# Конфигурация Caddy — веб-сервера, который:
# 1) отдаёт собранный фронтенд (статические файлы из /usr/share/caddy);
# 2) перенаправляет запросы /api/* на бэкенд-контейнер по имени
#    сервиса "backend" из docker-compose.yml (Docker сам настраивает
#    внутреннюю сеть, где контейнеры видят друг друга по имени);
# 3) сам получает и обновляет бесплатный HTTPS-сертификат
#    (Let's Encrypt) — как только {$DOMAIN} указывает на реальный
#    домен, а не на localhost. Вручную ничего настраивать не нужно.
#
# {$DOMAIN:localhost} — значение переменной окружения DOMAIN
# (задаётся в .env, см. .env.example), а если она не задана —
# используется localhost (для локальной проверки без домена).

{$DOMAIN:localhost} {
	# Всё, что начинается с /api/ — это запросы к бэкенду.
	# strip_prefix убирает "/api" перед тем как переслать запрос,
	# поэтому бэкенду ничего не нужно знать про этот префикс:
	# /api/health на фронтенде превращается в /health для бэкенда.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Всё остальное — собранный фронтенд (одностраничное приложение).
	# try_files гарантирует, что при обновлении страницы на любом
	# внутреннем адресе (например /events/5) сервер всё равно отдаст
	# index.html, а маршрутизацию внутри уже сделает React Router —
	# без этого браузер получал бы 404 при обновлении страницы.
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
		encode gzip
	}
}
