# Конфигурация Caddy — веб-сервера, который:
# 1) отдаёт собранный фронтенд (статические файлы из /usr/share/caddy);
# 2) перенаправляет запросы /api/* на бэкенд-контейнер по имени
#    сервиса "backend" из docker-compose.yml (Docker сам настраивает
#    внутреннюю сеть, где контейнеры видят друг друга по имени);
# 3) сам получает и обновляет бесплатный HTTPS-сертификат
#    (Let's Encrypt) — как только {$DOMAIN} указывает на реальный
#    домен, а не на localhost. Вручную ничего настраивать не нужно.
#
# {$DOMAIN:localhost} — значение переменной окружения DOMAIN
# (задаётся в .env, см. .env.example), а если она не задана —
# используется localhost (для локальной проверки без домена).
#
# В DOMAIN можно указать НЕСКОЛЬКО адресов через пробел — сайт будет
# открываться по каждому, и для каждого Caddy получит свой HTTPS-
# сертификат. Так основной домен и старый адрес работают одновременно:
#   DOMAIN="street-workout.online www.street-workout.online old.sslip.io"
# (значение с пробелами в .env нужно брать в кавычки).

{$DOMAIN:localhost} {
	# Адрес с "www." перенаправляем на тот же адрес без "www." (постоянный
	# редирект, путь и параметры сохраняются). Так у сайта один основной
	# адрес, а не два одинаковых. Если в DOMAIN нет адресов с "www." —
	# правило просто никогда не срабатывает.
	@www header_regexp www Host ^www\.(.+)$
	redir @www https://{re.www.1}{uri} permanent

	# Выдачу API (данные в формате JSON) поисковики индексировать не
	# должны, но читать её им можно и нужно: страницы сайта рисуются в
	# браузере из этих данных. Поэтому API не закрыт в robots.txt, а
	# помечен заголовком noindex. Загруженные фото (/api/uploads/) не
	# трогаем — их можно находить в поиске по картинкам.
	@api_data {
		path /api/*
		not path /api/uploads/*
	}
	header @api_data X-Robots-Tag "noindex"

	# robots.txt и sitemap.xml формирует бэкенд (карта сайта собирается
	# из базы и всегда актуальна). Они обязательно должны быть выше
	# "всего остального" ниже: иначе try_files отдал бы вместо них
	# index.html. Путь пересылается как есть, без strip_prefix.
	handle /robots.txt {
		reverse_proxy backend:8000
	}

	handle /sitemap.xml {
		reverse_proxy backend:8000
	}

	# Всё, что начинается с /api/ — это запросы к бэкенду.
	# strip_prefix убирает "/api" перед тем как переслать запрос,
	# поэтому бэкенду ничего не нужно знать про этот префикс:
	# /api/health на фронтенде превращается в /health для бэкенда.
	handle_path /api/* {
		reverse_proxy backend:8000
	}

	# Всё остальное — собранный фронтенд (одностраничное приложение).
	# try_files гарантирует, что при обновлении страницы на любом
	# внутреннем адресе (например /events/5) сервер всё равно отдаст
	# index.html, а маршрутизацию внутри уже сделает React Router —
	# без этого браузер получал бы 404 при обновлении страницы.
	handle {
		root * /usr/share/caddy
		try_files {path} /index.html
		file_server
		encode gzip
	}
}
