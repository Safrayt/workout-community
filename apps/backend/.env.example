# Скопируйте этот файл в .env на сервере и заполните реальными
# значениями. Сам .env в git не попадает (см. .gitignore) — здесь
# только пример/документация того, что нужно задать.

# "production" на сервере, "development" (или не задавать вовсе)
# локально. От этого зависят безопасные значения по умолчанию ниже.
ENVIRONMENT=production

# Ключ для подписи JWT-токенов. ОБЯЗАТЕЛЕН в production — при
# ENVIRONMENT=production и незаданном SECRET_KEY сервер откажется
# запускаться. Сгенерировать: openssl rand -hex 32
SECRET_KEY=

# Домен(ы) фронтенда через запятую, без слэша на конце.
CORS_ORIGINS=https://streetworkout.lol,https://www.streetworkout.lol

# Домен(ы), на которые сервер согласится отвечать, через запятую.
ALLOWED_HOSTS=streetworkout.lol,www.streetworkout.lol

# Отдавать ли /docs, /redoc, /openapi.json. По умолчанию в проде
# выключено; поставьте true, только если осознанно хотите открыть
# документацию API наружу.
ENABLE_DOCS=false
